function shrink ()
{
	gs					\
	  -q -dNOPAUSE -dBATCH -dSAFER		\
	  -sDEVICE=pdfwrite			\
	  -dCompatibilityLevel=1.3		\
	  -dPDFSETTINGS=/screen			\
	  -dEmbedAllFonts=true			\
	  -dSubsetFonts=true			\
	  -dAutoRotatePages=/None		\
	  -dColorImageDownsampleType=/Bicubic	\
	  -dColorImageResolution=$3		\
	  -dGrayImageDownsampleType=/Bicubic	\
	  -dGrayImageResolution=$3		\
	  -dMonoImageDownsampleType=/Subsample	\
	  -dMonoImageResolution=$3		\
	  -sOutputFile="$2"			\
	  "$1"
}

function check_smaller ()
{
	# If $1 and $2 are regular files, we can compare file sizes to
	# see if we succeeded in shrinking. If not, we copy $1 over $2:
	if [ ! -f "$1" -o ! -f "$2" ]; then
		return 0;
	fi
	ISIZE="$(echo $(wc -c "$1") | cut -f1 -d\ )"
	OSIZE="$(echo $(wc -c "$2") | cut -f1 -d\ )"
	if [ "$ISIZE" -lt "$OSIZE" ]; then
		echo "Input smaller than output, doing straight copy" >&2
		cp "$1" "$2"
	fi
}


function do_shrink() {

	# Output resolution defaults to 72 unless given:
	if [ ! -z "$3" ]; then
		res="$3"
	else
		res="72"
	fi
    
	IFILE="$1"
	transform_name "$IFILE" "_shrinked_$res"
	# Need an input file:
	if [ -z "$IFILE" ]; then
		usage "$0"
		exit 1
	fi

	# Output filename defaults to "-" (stdout) unless given:
	if [ ! -z "$2" ]; then
		OFILE="$2"
	else
		OFILE="-"
	fi

	shrink "$IFILE" "$ofile" "$res" || exit $?

	check_smaller "$IFILE" "$ofile"
}


function do_grayscale() {
    local FILE="$1"
    transform_name "$FILE" "_bw"
    # snippet from :
    # https://superuser.com/questions/104656/convert-a-pdf-to-greyscale-on-the-command-line-in-floss by https://superuser.com/users/107493/eroen
    gs \
	-sOutputFile="$ofile" \
	-sDEVICE=pdfwrite \
	-sColorConversionStrategy=Gray \
	-dProcessColorModel=/DeviceGray \
	-dCompatibilityLevel=1.4 \
	-dNOPAUSE \
	-dBATCH "$FILE"
}

function do_cat {
        local FILE="$1"
	local spec="$2"
	local b=
	local t=
	local s=
	b="${FILE%.*}"
	s="${spec// /_}"
	t="$b.cat:$s.pdf"
	echo "processing 'cat: $s' ..."
	pdftk "$FILE" cat "$spec" output "$t" && echo "output file: $t"
}


function do_flat {
	local FILE="$1"
	local DIR=$(mktemp -d)
	b="${FILE%.*}"
	t="$b.flat.pdf"
	fullfile="$(readlink -f "$FILE")"
	cd "$DIR" 
	test $? != 0 && echo "error cannot change dir: $DIR" && return 3
	
	# Get page dimensions from original file to preserve them
	local PAGE_DIMENSIONS=""
	local FIRST_PAGE_INFO=$(pdftk "$fullfile" dump_data 2>/dev/null | grep "PageMediaDimensions" | head -1)
	if [[ "$FIRST_PAGE_INFO" =~ PageMediaDimensions:[[:space:]]*([0-9.]+)[[:space:]]+([0-9.]+) ]]; then
		local PAGE_WIDTH="${BASH_REMATCH[1]}"
		local PAGE_HEIGHT="${BASH_REMATCH[2]}"
		PAGE_DIMENSIONS="${PAGE_WIDTH}x${PAGE_HEIGHT}"
		echo "preserving page dimensions: ${PAGE_DIMENSIONS} points"
	fi
	
	pdftoppm "$fullfile" flatpage
	ls -1
	echo "convert... "
	
	# Convert images to PDF, preserving original page dimensions if available
	if [[ -n "$PAGE_DIMENSIONS" ]]; then
		# Use -page to set page dimensions in points
		convert flatpage*.ppm -page "$PAGE_DIMENSIONS" $t
	else
		# Fallback: convert without specifying dimensions
		convert flatpage*.ppm $t
	fi
	
	ORIGDIR="$(dirname "$fullfile")"
	mv -v "$t" "$ORIGDIR"
}

function do_merge {
	local FILE="$1"
	shift
	pdftk $* cat output "$FILE" && echo "output file: $FILE"
}


function do_strip {
	local FILE="$1"
	exiftool -r -all:all= "$FILE"
	exiftool -r -all "$FILE"
}

# Replace specific pages from main PDF with pages from replacement PDF
# Usage: do_replace <main-file> <replacement-file> <page-list> [output-file]
# page-list format: comma-separated page numbers (e.g., "1,3,5" or "1-3,5")
# output-file: optional, if not provided, defaults to <main-file>_replaced.pdf
function do_replace {
	local MAIN_FILE="$1"
	local REPLACEMENT_FILE="$2"
	local PAGE_LIST="$3"
	local OUTPUT_FILE="$4"
	
	# Validate required arguments
	if [[ -z "$MAIN_FILE" ]] || [[ -z "$REPLACEMENT_FILE" ]] || [[ -z "$PAGE_LIST" ]]; then
		echo "error: replace command requires at least 3 arguments: <main-file> <replacement-file> <page-list> [output-file]"
		echo "       example: ${PEGASO_SCRIPT_FILE} replace main.pdf replacement.pdf \"1,3,5\" [output.pdf]"
		exit 1
	fi
	
	# Check if pdftk is available
	which pdftk > /dev/null
	if [[ $? != 0 ]]; then
		echo "error: 'pdftk' command not found, install it first"
		exit 2
	fi
	
	# Check if files exist
	if [[ ! -f "$MAIN_FILE" ]]; then
		echo "error: main file not found: $MAIN_FILE"
		exit 1
	fi
	
	if [[ ! -f "$REPLACEMENT_FILE" ]]; then
		echo "error: replacement file not found: $REPLACEMENT_FILE"
		exit 1
	fi
	
	# Get number of pages in both files
	local MAIN_PAGES=$(pdftk "$MAIN_FILE" dump_data | grep NumberOfPages | awk '{print $2}')
	local REPLACEMENT_PAGES=$(pdftk "$REPLACEMENT_FILE" dump_data | grep NumberOfPages | awk '{print $2}')
	
	if [[ -z "$MAIN_PAGES" ]] || [[ -z "$REPLACEMENT_PAGES" ]]; then
		echo "error: could not determine number of pages in PDF files"
		exit 1
	fi
	
	# Check if replacement file has same number of pages as main file
	if [[ "$REPLACEMENT_PAGES" != "$MAIN_PAGES" ]]; then
		echo "error: replacement file has $REPLACEMENT_PAGES pages, but main file has $MAIN_PAGES pages"
		echo "       both files must have the same number of pages"
		exit 1
	fi
	
	# Parse page list and validate page numbers
	# Convert page list to array of page numbers
	local PAGES_TO_REPLACE=()
	local IFS=','
	for page_spec in $PAGE_LIST; do
		# Remove whitespace
		page_spec=$(echo "$page_spec" | tr -d '[:space:]')
		
		# Check if it's a range (e.g., "1-3")
		if [[ "$page_spec" =~ ^([0-9]+)-([0-9]+)$ ]]; then
			local start_page="${BASH_REMATCH[1]}"
			local end_page="${BASH_REMATCH[2]}"
			
			# Validate range
			if [[ "$start_page" -gt "$end_page" ]]; then
				echo "error: invalid page range: $page_spec (start > end)"
				exit 1
			fi
			
			if [[ "$start_page" -lt 1 ]] || [[ "$end_page" -gt "$MAIN_PAGES" ]]; then
				echo "error: page range $page_spec is out of bounds (1-$MAIN_PAGES)"
				exit 1
			fi
			
			# Add all pages in range
			for ((p=start_page; p<=end_page; p++)); do
				PAGES_TO_REPLACE+=("$p")
			done
		elif [[ "$page_spec" =~ ^[0-9]+$ ]]; then
			# Single page number
			if [[ "$page_spec" -lt 1 ]] || [[ "$page_spec" -gt "$MAIN_PAGES" ]]; then
				echo "error: page number $page_spec is out of bounds (1-$MAIN_PAGES)"
				exit 1
			fi
			PAGES_TO_REPLACE+=("$page_spec")
		else
			echo "error: invalid page specification: $page_spec"
			exit 1
		fi
	done
	
	# Generate output filename if not provided
	if [[ -z "$OUTPUT_FILE" ]]; then
		local MAIN_BASE="${MAIN_FILE%.*}"
		OUTPUT_FILE="${MAIN_BASE}_replaced.pdf"
	fi
	
	echo "processing: replacing pages ${PAGES_TO_REPLACE[*]} from $MAIN_FILE"
	echo "           using pages from $REPLACEMENT_FILE"
	
	# Build the page sequence for pdftk
	# We'll create an array of page sources: either from main or replacement file
	local PAGE_SEQUENCE=()
	
	for ((page=1; page<=MAIN_PAGES; page++)); do
		local should_replace=0
		for replace_page in "${PAGES_TO_REPLACE[@]}"; do
			if [[ "$page" == "$replace_page" ]]; then
				should_replace=1
				break
			fi
		done
		
		if [[ $should_replace -eq 1 ]]; then
			# Use page from replacement file (A=input1)
			PAGE_SEQUENCE+=("A${page}")
		else
			# Use page from main file (B=input2)
			PAGE_SEQUENCE+=("B${page}")
		fi
	done
	
	# Use simple pdftk combination without normalization
	# This preserves the original content and dimensions of all pages
	# Note: pages may have different sizes, but content will be preserved correctly
	pdftk A="$REPLACEMENT_FILE" B="$MAIN_FILE" cat "${PAGE_SEQUENCE[@]}" output "$OUTPUT_FILE"
	
	if [[ $? != 0 ]]; then
		echo "error: failed to combine pages"
		exit 1
	fi
	
	echo "output file: $OUTPUT_FILE"
	echo "note: page sizes are preserved from original files - pages may have different dimensions"
}

if [[ -z $FILE ]]; then
    syntax
    exit 1
fi
echo "CMD=$CMD"
case "$CMD" in
    removepwd)
    	shift
	shift
	removepwd "$FILE"
	;;
    shrink)
	shift
	shift
	do_shrink "$FILE" $*
	;;
    grayscale)
    	shift
	shift
	do_grayscale "$FILE"
	;;
    cat)
    	shift
	shift
    	do_cat "$FILE" $*
    	;;
    flat)
    	shift
    	shift
    	do_flat "$FILE" $*
    	;;
    stripmetadata)
    	shift
    	shift
	do_strip "$FILE" $*
	;;
    merge)
    	shift
    	shift
    	do_merge "$FILE" $*
    	;;
    replace)
    	shift
    	shift
    	do_replace "$FILE" $*
    	;;
    *)
	echo "unknown command: $CMD"
	syntax
	;;
esac

