#!/bin/bash

# Remove duplicate downloads from Firefox and Chrome (suffixes like (1), (2), etc.)
# Usage: pegaso-remove-browser-duplicates [options] directory ...

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Log levels: 0=quiet, 1=normal (default), 2=verbose
LOG_QUIET=0
LOG_NORMAL=1
LOG_VERBOSE=2
LOG_LEVEL=$LOG_NORMAL

log_msg() {
    local min_level=$1
    shift
    if [[ $LOG_LEVEL -ge $min_level ]]; then
        echo -e "$@"
    fi
}

parse_log_level() {
    case "$1" in
        quiet)   LOG_LEVEL=$LOG_QUIET ;;
        normal)  LOG_LEVEL=$LOG_NORMAL ;;
        verbose) LOG_LEVEL=$LOG_VERBOSE ;;
        *)
            echo -e "${RED}Error: Invalid log level '$1' (use quiet, normal, or verbose)${NC}" >&2
            exit 1
            ;;
    esac
}

show_help() {
    cat << 'EOF'
Usage: pegaso-remove-browser-duplicates [options] directory ...

Removes duplicate files created by Firefox or Chrome when downloading files
with existing names. Browsers add suffixes like (1), (2), (3) before the extension:
  Firefox: document.pdf, document(1).pdf, document(2).pdf
  Chrome:  document.pdf, document (1).pdf, document (2).pdf

The script:
  - Identifies groups of files with the same base name
  - Verifies that files have identical content (using SHA256 checksum)
  - When the plain name exists in the group, keeps that file and removes numbered copies
  - When the plain name is missing, keeps the most recent numbered copy (suffix unchanged)
  - Deletes all other duplicates in the group

Parameters:
  directory ...     One or more directories to process (required)
  -h, --help        Show this help message
  -log LEVEL        Log verbosity: quiet, normal (default), or verbose
  --no-verify       Skip content verification (use name only)
  --skip-checksum   Alias for --no-verify

Examples:
  pegaso-remove-browser-duplicates ~/Downloads                  # Process Downloads folder
  pegaso-remove-browser-duplicates ~/Downloads ~/Desktop      # Process multiple directories
  pegaso-remove-browser-duplicates --no-verify ~/Downloads      # Process without verifying content
  pegaso-remove-browser-duplicates -log quiet ~/Downloads       # Errors only, silent on success
  pegaso-remove-browser-duplicates -log verbose ~/Downloads   # Detailed per-file output

Notes:
  - Log levels: quiet (errors only), normal (default), verbose (per-file details)
  - By default, only files with identical content are removed (safe verification)
  - With --no-verify, files are considered duplicates by name only, without verifying content
  - When the plain name exists in an identical group, that file is always kept
  - Otherwise the most recent numbered copy is kept (suffix is not removed)
  - Supports multiple extensions (e.g.: .tar.gz)
  - Does not process subdirectories recursively
  - Each directory is processed independently; groups are not merged across directories
EOF
}

if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    show_help
    exit 0
fi

# Flag to skip content verification
SKIP_CONTENT_CHECK=false

# Argument parsing
TARGET_DIRS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-verify|--skip-checksum)
            SKIP_CONTENT_CHECK=true
            shift
            ;;
        -log|--log)
            if [[ $# -lt 2 ]]; then
                echo -e "${RED}Error: -log requires an argument (quiet, normal, or verbose)${NC}" >&2
                exit 1
            fi
            parse_log_level "$2"
            shift 2
            ;;
        --log=*)
            parse_log_level "${1#--log=}"
            shift
            ;;
        -*)
            echo -e "${RED}Error: Unknown option '$1'${NC}" >&2
            echo "Use --help to see available options" >&2
            exit 1
            ;;
        *)
            TARGET_DIRS+=("$1")
            shift
            ;;
    esac
done

if [[ ${#TARGET_DIRS[@]} -eq 0 ]]; then
    echo -e "${RED}Error: At least one directory is required${NC}" >&2
    echo "Use --help to see available options" >&2
    exit 1
fi

# Verify that all directories exist
for dir in "${TARGET_DIRS[@]}"; do
    if [[ ! -d "$dir" ]]; then
        echo -e "${RED}Error: Directory '$dir' does not exist${NC}" >&2
        exit 1
    fi
done

# Function to calculate checksum
calculate_checksum() {
    local file="$1"
    sha256sum "$file" | awk '{print $1}'
}

# Function to extract the base name from a file with or without suffix
# Firefox: "document(1).pdf"  -> "document.pdf"
# Chrome:  "document (2).pdf" -> "document.pdf"
#         "document(1).tar.gz" -> "document.tar.gz"
#         "document.pdf"       -> "document.pdf"
get_base_name() {
    local filename="$1"
    # Optional space before (N); handles multiple extensions too
    echo "$filename" | sed -E 's/ ?\([0-9]+\)(\..+)$/\1/'
}

# Function to check if a file has the duplicate pattern (Firefox or Chrome)
has_duplicate_pattern() {
    local filename="$1"
    [[ "$filename" =~ \ ?\([0-9]+\)\..+$ ]]
}

process_directory() {
    local TARGET_DIR="$1"
    local total_processed=0
    local total_removed=0
    local total_space_freed=0

    TARGET_DIR=$(realpath "$TARGET_DIR")

    log_msg $LOG_VERBOSE "${CYAN}=== Browser Duplicates Removal ===${NC}"
    log_msg $LOG_VERBOSE "Directory: ${GREEN}$TARGET_DIR${NC}"
    log_msg $LOG_VERBOSE ""

    # Associative array to group files by base name
    declare -A file_groups

    # Find all files in the directory
    while IFS= read -r -d '' filepath; do
        local filename
        local base_name
        filename=$(basename "$filepath")

        # Extract the base name (without suffix (N))
        base_name=$(get_base_name "$filename")

        # Add the file to the group
        if [[ -n "${file_groups[$base_name]:-}" ]]; then
            file_groups[$base_name]="${file_groups[$base_name]}|$filepath"
        else
            file_groups[$base_name]="$filepath"
        fi
    done < <(find "$TARGET_DIR" -maxdepth 1 -type f -print0)

    # Process each file group
    for base_name in "${!file_groups[@]}"; do
        IFS='|' read -ra files <<< "${file_groups[$base_name]}"

        # If there's only one file, skip
        if [[ ${#files[@]} -lt 2 ]]; then
            continue
        fi

        # Check if at least one has the duplicate pattern
        local has_duplicates=false
        for file in "${files[@]}"; do
            local filename
            filename=$(basename "$file")
            if has_duplicate_pattern "$filename"; then
                has_duplicates=true
                break
            fi
        done

        # If no file has the duplicate pattern, skip
        if [[ "$has_duplicates" = false ]]; then
            continue
        fi

        log_msg $LOG_NORMAL "${YELLOW}Group found: $base_name${NC}"

        # Array to store file info
        declare -A file_info
        declare -a valid_files

        # Collect information about each file
        for file in "${files[@]}"; do
            if [[ ! -f "$file" ]]; then
                continue
            fi

            filename=$(basename "$file")
            local size
            local mtime
            size=$(stat -c%s "$file")
            mtime=$(stat -c%Y "$file")

            file_info["$file,size"]=$size
            file_info["$file,mtime"]=$mtime
            file_info["$file,checksum"]=""

            valid_files+=("$file")

            log_msg $LOG_VERBOSE "  - $filename ($(numfmt --to=iec-i --suffix=B $size), $(date -d @$mtime '+%Y-%m-%d %H:%M:%S'))"
        done

        # If there's only one valid file, skip
        if [[ ${#valid_files[@]} -lt 2 ]]; then
            unset file_info
            unset valid_files
            continue
        fi

        # Array for identical files
        declare -a identical_files

        if [[ "$SKIP_CONTENT_CHECK" = true ]]; then
            # Mode without content verification: consider all files as identical
            log_msg $LOG_VERBOSE "  ${CYAN}ℹ --no-verify mode: files are considered duplicates without content verification${NC}"
            identical_files=("${valid_files[@]}")
        else
            # Verify that all files have the same content
            local reference_file="${valid_files[0]}"
            local reference_size="${file_info[$reference_file,size]}"

            # Calculate checksum of reference file
            file_info["$reference_file,checksum"]=$(calculate_checksum "$reference_file")
            local reference_checksum="${file_info[$reference_file,checksum]}"

            identical_files=("$reference_file")

            # Compare other files
            local all_identical=true
            for file in "${valid_files[@]:1}"; do
                local current_size="${file_info[$file,size]}"

                # If size is different, always calculate checksum
                if [[ "$current_size" != "$reference_size" ]]; then
                    file_info["$file,checksum"]=$(calculate_checksum "$file")
                    local current_checksum="${file_info[$file,checksum]}"

                    if [[ "$current_checksum" != "$reference_checksum" ]]; then
                        log_msg $LOG_NORMAL "  ${RED}✗ $(basename "$file") has different content (checksum: ${current_checksum:0:16}...)${NC}"
                        all_identical=false
                        continue
                    fi
                else
                    # Same size, calculate checksum for safety
                    file_info["$file,checksum"]=$(calculate_checksum "$file")
                    current_checksum="${file_info[$file,checksum]}"

                    if [[ "$current_checksum" != "$reference_checksum" ]]; then
                        log_msg $LOG_NORMAL "  ${RED}✗ $(basename "$file") has different content${NC}"
                        all_identical=false
                        continue
                    fi
                fi

                identical_files+=("$file")
            done

            # If not all files are identical, warn and skip
            if [[ "$all_identical" = false ]]; then
                log_msg $LOG_NORMAL "  ${YELLOW}⚠ Not all files are identical, group skipped${NC}"
                log_msg $LOG_VERBOSE ""
                unset file_info
                unset valid_files
                unset identical_files
                continue
            fi
        fi

        # Choose which file to keep:
        # - plain name (no suffix) when present in the identical group
        # - otherwise the most recent numbered copy (keep suffix, no rename)
        local target_dir
        local keeper_file=""
        local keeper_filename

        target_dir=$(dirname "${identical_files[0]}")

        local newest_file=""
        local newest_mtime=0
        for file in "${identical_files[@]}"; do
            mtime="${file_info[$file,mtime]}"
            if [[ $mtime -gt $newest_mtime ]]; then
                newest_mtime=$mtime
                newest_file="$file"
            fi
        done

        for file in "${identical_files[@]}"; do
            if [[ "$(basename "$file")" == "$base_name" ]]; then
                keeper_file="$file"
                break
            fi
        done

        if [[ -n "$keeper_file" ]]; then
            keeper_filename="$base_name"
        else
            keeper_file="$newest_file"
            keeper_filename=$(basename "$keeper_file")
        fi

        log_msg $LOG_VERBOSE "  ${GREEN}✓ All files are identical${NC}"
        if [[ "$keeper_filename" == "$base_name" ]]; then
            log_msg $LOG_NORMAL "  ${CYAN}→ Keeping plain file: $base_name${NC}"
        else
            log_msg $LOG_NORMAL "  ${CYAN}→ No plain file in group; keeping most recent: $keeper_filename${NC}"
        fi

        # Remove all other duplicate files
        for file in "${identical_files[@]}"; do
            if [[ "$file" != "$keeper_file" ]]; then
                if [[ -f "$file" ]]; then
                    size="${file_info[$file,size]}"
                    rm -f "$file"
                    log_msg $LOG_NORMAL "  ${GREEN}✓ Removed: $(basename "$file")${NC}"
                    total_removed=$((total_removed + 1))
                    total_space_freed=$((total_space_freed + size))
                fi
            fi
        done

        # Keep the most recent mtime from the group on the surviving file
        if [[ -f "$keeper_file" ]] && [[ "${file_info[$keeper_file,mtime]}" -lt $newest_mtime ]]; then
            touch -d "@$newest_mtime" "$keeper_file"
            log_msg $LOG_NORMAL "  ${CYAN}→ Updated timestamp to $(date -d @$newest_mtime '+%Y-%m-%d %H:%M:%S')${NC}"
        fi

        total_processed=$((total_processed + 1))
        log_msg $LOG_VERBOSE ""

        unset file_info
        unset valid_files
        unset identical_files
    done

    # Per-directory summary
    log_msg $LOG_NORMAL "${CYAN}=== Summary: $TARGET_DIR ===${NC}"
    log_msg $LOG_NORMAL "Groups processed: ${GREEN}$total_processed${NC}"
    log_msg $LOG_NORMAL "Files removed: ${GREEN}$total_removed${NC}"
    log_msg $LOG_NORMAL "Space freed: ${GREEN}$(numfmt --to=iec-i --suffix=B $total_space_freed)${NC}"

    if [[ $total_processed -eq 0 ]]; then
        log_msg $LOG_NORMAL "${YELLOW}No duplicates found.${NC}"
    fi
    log_msg $LOG_NORMAL ""

    GRAND_PROCESSED=$((GRAND_PROCESSED + total_processed))
    GRAND_REMOVED=$((GRAND_REMOVED + total_removed))
    GRAND_SPACE_FREED=$((GRAND_SPACE_FREED + total_space_freed))
}

GRAND_PROCESSED=0
GRAND_REMOVED=0
GRAND_SPACE_FREED=0

for dir in "${TARGET_DIRS[@]}"; do
    process_directory "$dir"
done

if [[ ${#TARGET_DIRS[@]} -gt 1 ]]; then
    log_msg $LOG_NORMAL "${CYAN}=== Overall Summary (${#TARGET_DIRS[@]} directories) ===${NC}"
    log_msg $LOG_NORMAL "Groups processed: ${GREEN}$GRAND_PROCESSED${NC}"
    log_msg $LOG_NORMAL "Files removed: ${GREEN}$GRAND_REMOVED${NC}"
    log_msg $LOG_NORMAL "Space freed: ${GREEN}$(numfmt --to=iec-i --suffix=B $GRAND_SPACE_FREED)${NC}"
fi

exit 0
